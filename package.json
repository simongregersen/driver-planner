{
  "name": "driver-planner",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "test": "ng test",
    "prod": "ng build --configuration production",
    "deploy": "ng build --configuration production && firebase deploy",
    "emulators": "ng build --configuration development && firebase emulators:start --import=./.emulator-data --export-on-exit",
    "emulators:pwa": "ng build --configuration pwa-emulator && firebase emulators:start --import=./.emulator-data --export-on-exit",
    "send-notifications": "node scripts/send-notifications.mjs",
    "lint": "ng lint",
    "format": "prettier --write \"src/**/*.{ts,html,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,html,css}\"",
    "test:rules": "firebase emulators:exec --only database --config firebase.test.json --project driver-planner \"node test/integration/database-rules.spec.mjs\""
  },
  "private": true,
  "dependencies": {
    "@angular/cdk": "^22.1.1",
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/localize": "^22.1.0",
    "@angular/material": "^22.1.1",
    "@angular/material-moment-adapter": "^22.1.1",
    "@angular/platform-browser": "^22.1.0",
    "@angular/router": "^22.1.0",
    "@angular/service-worker": "^22.1.0",
    "@fontsource/roboto": "^5.3.0",
    "firebase": "^12.17.0",
    "material-icons": "^1.13.14",
    "moment": "^2.30.1",
    "rxfire": "^6.2.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.16.2"
  },
  "devDependencies": {
    "@angular/build": "^22.1.2",
    "@angular/cli": "^22.1.2",
    "@angular/compiler-cli": "^22.1.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.0",
    "angular-eslint": "22.1.0",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "firebase-admin": "^14.2.0",
    "firebase-tools": "^15.27.0",
    "jsdom": "^28.0.0",
    "prettier": "^3.9.6",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.62.1",
    "vitest": "^4.0.8"
  },
  "allowScripts": {
    "@firebase/util@1.15.2": true,
    "@parcel/watcher@2.6.0": true,
    "esbuild@0.28.2": true,
    "lmdb@3.5.6": true,
    "msgpackr-extract@3.0.4": true,
    "protobufjs@7.6.5": true,
    "re2@1.26.1": true
  }
}
